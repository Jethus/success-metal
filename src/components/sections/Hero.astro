---
import ImageBlock from "../primitives/ImageBlock.astro"
import heroImage from "../../assets/webp/hero.webp"
---

<section id="hero">
  <div class="container">
    <div class="flex-group-col">
      <h1>
        Custom Metal Products.<br>
        <span>Proven Fabrication Expertise.</span>
      </h1>
      <div class="flex-text">
        <p class="topper">Leading in North America</p>
        <p>
          Specialized in creating finished products for large manufacturing industries - from custom components to high-volume production support.
        </p> 
      </div>
      <div class="flex-group-row">
        <a href="/contact " class="btn-primary">Custom Quote 
          <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 15 15"><path fill="currentColor" d="M8.293 2.293a1 1 0 0 1 1.414 0l4.5 4.5a1 1 0 0 1 0 1.414l-4.5 4.5a1 1 0 0 1-1.414-1.414L11 8.5H1.5a1 1 0 0 1 0-2H11L8.293 3.707a1 1 0 0 1 0-1.414"/></svg>
        </a>
        <a href="/gallery" class="btn-secondary">See our work</a>
      </div>
    </div>
  </div>
  <ImageBlock src={heroImage} alt="" class="hero-image" />
</section>

<style lang="scss">
  @use "@styles" as *;

  #hero {
    container-type: inline-size;
    background: $dark;
    position: relative;
    grid-template-columns: 1fr minmax(0, 800px) minmax(0, 800px) 1fr;
    .container {
      flex-direction: column-reverse;
    }
    .flex-group-col {
      align-items: flex-start;
      padding: 8rem 0;
      h1 {
        font-size: var(--font-size-xxxl);
        line-height: 1.4;
        font-weight: $black;
        color: $light;
        margin-bottom: 4rem;
        span {
          color: $brand-primary;
          white-space: nowrap;
        }
      }
      .topper ~ p {
        font-size: var(--font-size-md);
        font-family: $header-font;
        font-weight: $bold;
        color: $light;
      }
      .flex-group-row {
        display: flex;
        gap: 1.25rem;
        width: 100%;
        flex-direction: column;
      }
    }
    picture {
      position: absolute;
      width: 100%;
      height: 100%;
      .hero-image {
        position: absolute;
        object-fit: cover;
        object-position: center;
        width: 100%;
        height: 100%;
        opacity: 0.33;
      }
    }
      @include container-query(large-mobile) {
      .flex-group-col {
        .flex-group-row {
          flex-direction: row;
        }
      }
      .hero-image {
      }
    }
    @include container-query(small-laptop) {
      .container {
        flex-direction: row;
      }
      align-items: center;

      .flex-group-col {
        flex: 0 0 75%;
      }
      .hero-image {
      }
    }
  }
</style>
