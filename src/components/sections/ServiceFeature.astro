---
import { type CollectionEntry } from "astro:content";
import ImageBlock from "../primitives/ImageBlock.astro";

type Props = CollectionEntry<"services">["data"];

const { heading, image, order, specs } = Astro.props as Props;
---

<div class={`service-feature${order % 2 === 0 ? " flipped secondary-bg" : ""}`}>
  <div class="flex-group-col">
    <h3>{heading}</h3>
    <slot />
    {specs.length > 0 && (
      <ul class="specs-list">
        {specs.map((spec) => (
          <li>
            <span class="spec-value">{spec.value}</span>
            <span class="spec-label">{spec.label}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
  <ImageBlock
    src={image}
    class="service-image"
    alt=""
    width={1200}
    height={1500}
    loading="lazy"
  />
</div>

<style lang="scss">
  @use "@styles" as *;
  @use "sass:color";
  .service-feature {
    display: grid;
    grid-template-columns: 1fr minmax(0, 720px) minmax(0, 720px) 1fr;
    background-color: $main-bg;
    list-style: none;
    &.flipped {
      picture {
        grid-column: 1/3;
        grid-row: 1;
      }
        .flex-group-col {
          grid-column: 3/4;
          grid-row: 1;
          padding-right: 0;
          padding-left: 3rem;
        }
    }
    &.secondary-bg {
      background-color: $secondary-bg;
    }
    .flex-group-col {
      grid-column: 2/3;
      align-items: flex-start;
      justify-content: center;
      gap: 0.5rem;
      padding: 3rem;
      padding-left: 0;
       .specs-list {
          list-style: none;
          padding: 0;
          margin: 1rem 0;
          display: flex;
          gap: 2rem;
          flex-wrap: wrap;
          & li:first-child {
            padding-bottom: 2rem;
            border-bottom: 2px solid color.scale($brand-text, $lightness: -50%);
          }
          li {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            gap: 0.25rem;
            width: 100%;
          }
    .spec-value {
      font-size: var(--font-size-xxxl);
      font-family: $header-font;
      font-weight: $bold;
      color: $brand-primary;
    }
    .spec-label {
      font-size: var(--font-size-lg);
      color: $light;
    }
  }
    }
    picture {
      grid-column: 3/-1;
      width: 100%;
      .service-image {
        max-height: 800px;
        object-position: 0 top;
      }
    }
 
}
</style>
