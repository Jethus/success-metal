---

<form
  name="contact"
  method="POST"
  data-netlify="true"
  data-netlify-recaptcha="true"
  class="contact-form"
  netlify-honeypot="extra-info"
  action="/contact-success"
>
  <input type="hidden" name="form-name" value="contact" />
  <div class="input-area">
    <label for="name">Name <span class="required">*</span></label>
    <input
      type="text"
      id="name"
      name="name"
      placeholder="John Smith"
      required
    />
  </div>
  <div class="input-area">
    <label for="email">Email <span class="required">*</span></label>
    <input
      type="email"
      id="email"
      name="email"
      placeholder="john@domain.com"
      required
    />
  </div>
  <div class="input-area">
    <label for="phone">Phone</label>
    <input type="tel" id="phone" name="phone" placeholder="905-123-4567" />
  </div>
  <div class="input-area">
    <label for="details">Project Details <span class="required">*</span></label>
    <textarea
      id="details"
      name="details"
      placeholder="Please describe your project requirements, materials, timeline, and any specifications"
      rows="5"
      required
    >
    </textarea>
  </div>
  <div class="input-area" style="display:none;">
    <label for="extra-info"
      >Additional Info
      <input
        type="text"
        id="extra-info"
        name="extra-info"
        placeholder="You may provide any extra information here"
      />
    </label>
  </div>
  <!-- Netlify reCAPTCHA widget -->
  <div class="recaptcha">
    <div data-netlify-recaptcha="true"></div>
  </div>
  <button class="btn-primary" type="submit">Submit Request</button>
</form>

<style lang="scss">
  @use "@styles" as *;
  @use "sass:color";

  .contact-form {
    @include flex-group-col;
    @include border-style;
    margin: 0 auto;
    gap: 2rem;
    background: $dark-bg;
    border-radius: 8px;
    box-shadow: $drop-shadow;
    padding: 2rem;
    align-items: flex-start;
    max-width: 600px;
    width: 100%;

    .input-area {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      width: 100%;
      .required {
        color: red;
      }
    }
    label {
      font-family: $header-font;
      font-weight: $bold;
      font-size: var(--font-size-base-md);
      color: $light;
    }
    input,
    textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid rgba($brand-primary, 0.2);
      border-radius: 4px;
      font-size: var(--font-size-base-md, 1rem);
      font-family: "Noto Sans", Arial, sans-serif;
      background: $light;
      color: $brand-text;
      transition: border-color 0.2s;
      &:focus {
        border-color: $brand-action;
        outline: none;
      }
    }
    .recaptcha {
      margin-top: 1rem;
    }
  }
</style>

<script is:inline>
  document.getElementById("phone").addEventListener("input", function (e) {
    let input = e.target.value.replace(/\D/g, ""); // Remove all non-numeric characters
    let formatted = "";

    if (input.length > 0) {
      formatted += input.substring(0, 3); // First three digits
    }
    if (input.length > 3) {
      formatted += " - " + input.substring(3, 6); // Next three digits
    }
    if (input.length > 6) {
      formatted += " - " + input.substring(6, 10); // Final four digits
    }

    e.target.value = formatted; // Update the input field
  });
</script>
