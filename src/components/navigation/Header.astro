---
import HeaderLink from "./HeaderLink.astro";
import { Image } from "astro:assets";
import logo from "../../assets/svgs/success-metal-logo.svg";
---

<header>
  <div class="backdrop"></div>
  <div class="backdrop-edge"></div>
  <nav id="nav">
    <a href="/" class="logo" aria-label="back to home">
      <Image
        priority
        src={logo}
        alt="Crescendo Stage"
        width={309}
        height={60}
      />
    </a>
    <div class="desktop-links">
      <HeaderLink href="/gallery">Gallery</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <span id="contact">
        <HeaderLink href="/contact">Contact Us</HeaderLink> | <HeaderLink
          href="tel:6137909112">(613) 790-9112</HeaderLink
        >
      </span>
    </div>

    <button
      id="nav-toggle"
      class="hamburger"
      aria-label="Mobile menu toggle"
      aria-controls="mobile-nav"
      aria-expanded="false"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <div id="mobile-nav" class="mobile-links" data-visible="false">
      <HeaderLink href="/gallery">Gallery</HeaderLink>
      <HeaderLink href="/about">About</HeaderLink>
      <HeaderLink href="/contact">Contact Us</HeaderLink>
    </div>
  </nav>
</header>

<style lang="scss">
  @use "@styles" as *;
  @use "sass:color";
  // header as container
  header {
    container-type: inline-size;
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 99;
    background-color: rgba($dark, 0.25);
  }

  .backdrop {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    height: 200%;
    backdrop-filter: blur(1rem);
    -webkit-backdrop-filter: blur(1rem);
    mask-image: linear-gradient(to bottom, black 0% 50%, transparent 50% 100%);
    pointer-events: none;

    @supports (
      mask-image: linear-gradient(to bottom, black 0% 50%, transparent 50% 100%)
    ) {
      mask-image: linear-gradient(
        to bottom,
        black 0% 50%,
        transparent 50% 100%
      );
    }

    @supports not (
      mask-image: linear-gradient(to bottom, black 0% 50%, transparent 50% 100%)
    ) {
      height: 100%;
      background: linear-gradient(
        to bottom,
        rgba(255, 255, 255, 0.1) 0%,
        rgba(255, 255, 255, 0) 100%
      );
    }
  }

  .backdrop-edge {
    $thickness: 2px;
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    height: 100%;
    transform: translateY(100%);
    pointer-events: none;

    @supports (
      mask-image: linear-gradient(
          to bottom,
          black 0,
          black $thickness,
          transparent $thickness
        )
    ) {
      backdrop-filter: blur(8px) brightness(120%);
      -webkit-backdrop-filter: blur(8px) brightness(120%);
      background: hsl(0deg 0% 100% / 0.1);
      mask-image: linear-gradient(
        to bottom,
        black 0,
        black $thickness,
        transparent $thickness
      );
    }

    @supports not (
      mask-image: linear-gradient(
          to bottom,
          black 0,
          black $thickness,
          transparent $thickness
        )
    ) {
      display: none;
    }
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1.5rem 2rem;
    box-shadow: 0 2px 4px rgba($dark, 0.12);
    margin-inline: auto;
    border-radius: 0;
    position: relative;
    z-index: 2;
    .logo {
      height: 40px;
      img {
        width: auto;
        height: 40px;
      }
    }
    .desktop-links {
      display: none;
    }
  }

  // burger menu style, variables to ensure lines are square
  $hamburger-width: 56px;
  $hamburger-height: 32px;
  $patty-height: 5px;
  .hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    position: relative;
    width: $hamburger-width;
    height: $hamburger-height;
    border: none;
    background: transparent;
    cursor: pointer;
    transition: transform 0.3s ease;
    z-index: 99;
    &:hover,
    &:focus-visible {
      animation: breathe-full 2s ease-in-out infinite;
    }
    span {
      display: block;
      position: absolute;
      height: $patty-height;
      width: 100%;
      background: $light;
      border-radius: 8px;
      @include transition-slow(all);
      &:nth-child(1) {
        transform: translateY(
          calc(($hamburger-height - $patty-height) / 2 * -1)
        );
      }

      &:nth-child(2) {
        transform: translateY(0);
        width: 75%;
        align-self: flex-end;
      }

      &:nth-child(3) {
        transform: translateY(calc(($hamburger-height - $patty-height) / 2));
      }
    }

    &.open span {
      &:nth-child(1) {
        transform: rotate(45deg);
      }
      &:nth-child(2) {
        transform: translateX(-4rem);
        opacity: 0;
      }
      &:nth-child(3) {
        transform: rotate(-45deg);
      }
    }
  }

  // mobile slide-in drawer
  .mobile-links {
    display: flex;
    position: fixed;
    background-color: rgba($dark, 0.8);
    backdrop-filter: blur(0.25rem);
    font-size: var(--font-size-md);
    inset-block-start: 0;
    inset-inline-end: 0;
    width: 100%;
    min-width: 200px;
    height: 100vh;
    padding-top: 6rem;
    align-items: flex-end;
    font-weight: $bold;
    flex-direction: column;
    gap: 0.25rem;
    transform: translateX(120%);
    @include transition-slow(transform, box-shadow);
    box-shadow: none;
    text-align: right;
    z-index: 10;

    &[data-visible="true"] {
      transform: translateX(0);
      box-shadow: -8px 0 16px rgba($dark, 0.12);
    }

    a {
      width: 100%;
      padding: 1rem;
      @include transition-fast(background-color);
      &:hover,
      &:focus-visible {
        background-color: $secondary-bg;
      }
    }
  }

  // tablet style adjustments
  @include container-query(small-laptop) {
    nav {
      padding: 2rem 2.5rem;
      .logo {
        height: 50px;
        & img {
          height: 50px;
        }
      }
      .desktop-links {
        display: flex;
        align-items: center;
        gap: 2.5rem;
        font-size: var(--font-size-base-md);
        #contact {
          font-size: var(--font-size-base-md);
        }
        font-weight: bold;
      }
      .hamburger,
      .mobile-links {
        display: none;
      }
    }
  }
  @include container-query(large-laptop) {
    nav {
      .logo {
        height: 60px;
        & img {
          height: 60px;
        }
      }
      .desktop-links {
        font-size: var(--font-size-md);
        #contact {
          font-size: var(--font-size-md);
        }
      }
    }
  }
</style>

<script is:inline>
  const toggle = document.getElementById("nav-toggle");
  const mobileMenu = document.getElementById("mobile-nav");

  toggle.addEventListener("click", () => {
    const isOpen = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", !isOpen);
    mobileMenu.dataset.visible = String(!isOpen);
    toggle.classList.toggle("open", !isOpen);
  });
</script>
