---
import { Image } from "astro:assets";

export type Props = {
  title: string;
  icon: any;
};

const { title, icon } = Astro.props;
---

<div class="card">
  <div class="card-title">
    {
      icon && (
        <span class="card-icon">
          <Image src={icon} alt="" width={40} height={40} />
        </span>
      )
    }
    {title}
  </div>
  <div class="card-content">
    <slot />
  </div>
</div>

<style lang="scss">
  @use "@styles" as *;
  .card {
    box-shadow: $drop-shadow;
    @include border-style;
    background: $dark-bg;
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
    .card-title {
      font-size: var(--font-size-base-md);
      font-family: $header-font;
      font-weight: $bold;
      color: $light;
      margin-bottom: 1rem;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      .card-icon {
        background-color: $brand-primary;
        border-radius: 10rem;
        width: 5rem;
        height: 5rem;
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
    }
    .card-content {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      ul {
        li {
          list-style: disc;
        }
      }
    }
  }
</style>
