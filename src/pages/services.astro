---
import Layout from "../layouts/Basic.astro";
import OneColumn from "../components/layout/OneColumn.astro";
import TwoColumn from "../components/layout/TwoColumn.astro";
import Tabs from "../components/interactive/Tabs.astro";
import ImageBlock from "../components/primitives/ImageBlock.astro";
import Card from "../components/primitives/Card.astro";
import Accordion from "../components/interactive/Accordion.astro";
import ClosingCTA from "../components/sections/ClosingCTA.astro";
---

<Layout
  title="Our Services"
  description="Discover Crescendo Stage's AI solutions and digital services for automating operations, streamlining workflows, and driving enterprise growth."
>
  <OneColumn title="Services" heading="h1" id="services">
    <p>
      Explore our comprehensive range of services designed to enhance your business operations. From AI-driven solutions to custom software development, we provide the expertise and technology to help you succeed.
    </p>
  <ClosingCTA />
</Layout>

<style lang="scss" is:global>
  @use "@styles" as *;

  #ai-solutions {
    background: $gradient-bg;
    padding: 0;
    .container {
      flex-direction: column-reverse;
      .right-image {
        max-height: 250px;
      }
      .flex-group-col {
        flex: 0 0 50%;
        padding: 2rem $gutter;
        align-items: flex-start;
      }
      @include container-query(small-laptop) {
        flex-direction: row;
        .right-image {
          max-height: 100%;
        }
      }
    }
  }
  #ai-configure {
    background-color: $off-white-bg;
    .right-side {
      display: none;
      flex: 0 0 50%;
      img {
        box-shadow: $drop-shadow;
        border-radius: 0.5rem;
      }
    }
    @include container-query(small-laptop) {
      .right-side {
        display: block;
      }
    }
  }
  #process-automation {
    background-color: $light;
    .right-side {
      @include flex-group-col;
    }
  }
  #back-end,
  #capabilities,
  #benefits,
  #back-end2 {
    background-color: $white-bg;
  }
  #back-end {
    .flex-group-col {
      align-items: flex-start;
    }
  }
  #capabilities,
  #benefits {
    .left-side {
      flex: 0 0 25%;
    }
    .rifght-side {
      flex: 0 0 75%;
    }
  }
  #data-analytics,
  #consulting {
    .left-side {
      flex: 0 0 55%;
    }
    .right-side {
      flex: 0 0 45%;
    }
  }
  #data-analytics {
    background-color: $off-white-bg;
    .left-side {
      flex: 0 0 55%;
    }
    .right-side {
      flex: 0 0 45%;
    }
  }
</style>
