---
import BaseHead from "../components/navigation/BaseHead.astro";
import Header from "../components/navigation/Header.astro";
import Footer from "../components/navigation/Footer.astro";
import OneColumn from "../components/layout/OneColumn.astro";
import ContactCTA from "../components/sections/ContactCTA.astro";
import Hero from "../components/sections/Hero.astro";
import Solutions from "../components/sections/Solutions.astro";
import ServiceFeature from "../components/sections/ServiceFeature.astro";
import Partners from "../components/sections/Partners.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";

import loblaws from "../assets/svgs/partners/loblaws.svg";
import gayLea from "../assets/svgs/partners/gay-lea.svg";
import fgf from "../assets/svgs/partners/fgf.svg";
import mercedes from "../assets/svgs/partners/mercedes-benz.svg";
import iko from "../assets/svgs/partners/iko.svg";
import wonderbrands from "../assets/svgs/partners/wonderbrands.svg";

import { getCollection, render } from "astro:content";
const services = (await getCollection("services")).sort(
  (a, b) => (a.data.order ?? Infinity) - (b.data.order ?? Infinity)
);

const rendered = await Promise.all(
  services.map(async (item) => {
    const { Content } = await render(item);
    return { data: item.data, Content };
  })
);

const partners = [
  { src: loblaws, name: "Loblaws" },
  { src: gayLea, name: "Gay Lea" },
  { src: fgf, name: "FGF" },
  { src: mercedes, name: "Mercedes-Benz" },
  { src: iko, name: "IKO" },
  { src: wonderbrands, name: "Wonderbrands" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <Hero />
      <Solutions />
      <OneColumn id="services" width="full-width">
        <ul>
          {
            rendered.map(({ data, Content }) => (
              <li>
                <ServiceFeature {...data}>
                  <Content />
                </ServiceFeature>
              </li>
            ))
          }
        </ul>
      </OneColumn>
      <Partners images={partners} />
    </main>
    <ContactCTA />
    <Footer />
  </body>
</html>

<style lang="scss" is:global>
  @use "@styles" as *;

  #services {
    padding: 0;
    .container {
      .flex-group-col {
        ul {
          width: 100%;
          list-style: none;
          padding: 0;
          li {
            margin: 0;
          }
        }
      }
    }
  }
</style>
