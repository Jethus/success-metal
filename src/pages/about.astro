---
import { Image } from "astro:assets";
import Layout from "../layouts/Basic.astro";
import OneColumn from "../components/layout/OneColumn.astro";
import TwoColumn from "../components/layout/TwoColumn.astro";
import ContactCTA from "../components/sections/ContactCTA.astro";
import ImageBlock from "../components/primitives/ImageBlock.astro";
import cwb_cert from "../assets/png/cwb-cert.png";
import iso_cert from "../assets/png/iso-cert.png";
import ontario_cert from "../assets/png/ontario-cert.png";
import about_hero from "../assets/webp/about-hero.webp";
---

<Layout title="About Us" description="">
  <TwoColumn title="About Us" heading="h1" id="about-hero" width="full-width">
    <p slot="left">
      We believe the future is being built where the intersection of digital
      technologies and human expertise will empower solutions that will redefine
      what’s possible.
    </p>
    <ImageBlock
      slot="right"
      src={about_hero}
      alt=""
      width="1359"
      height="750"
      loading="eager"
      class="right-image"
      layout="full-width"
      priority
    />
  </TwoColumn>
  <OneColumn title="about" id="about">
    <h2>What We Do</h2>
    <p>
      We offer a complete suite of metal services, from raw material sales to
      advanced fabrication. Our team combines technical expertise with a
      commitment to quality, ensuring every project meets your specifications
      and exceeds expectations.
    </p>
    <ul>
      <li>
        <strong>Laser Processing:</strong> Precision cutting for sheets up to 80”
        x 240”, .016” to .750” gauge.
      </li>
      <li>
        <strong>Custom Forming:</strong> Six brake presses, forming up to 1.5” thick,
        14’ max bend length.
      </li>
      <li>
        <strong>Complete Fabrication:</strong> Certified welders and full capabilities:
        punching, beveling, sawing, drilling, and welding for production runs.
      </li>
      <li>
        <strong>Custom Shearing:</strong> Eight shears, handling .024” to .750” thickness,
        up to 14’ lengths.
      </li>
    </ul>
    <div class="certs">
      <Image src={ontario_cert} alt="Ontario Made" width={150} height={150} />
      <Image
        src={cwb_cert}
        alt="Certification CWB, CSA W47.1"
        width={150}
        height={150}
      />
      <Image src={iso_cert} alt="ISO 9001:2015" width={150} height={150} />
    </div>
    <h3>Our Commitment</h3>
    <p>
      Every challenge is an opportunity for us to deliver value. We focus on
      cost, quality, service, and timely delivery—making sure your experience is
      as strong and dependable as our products.
    </p>
    <h3>Let’s Build Together</h3>
    <p>
      Success Metal Manufacturing is your one-stop shop for sheet and plate,
      sheared and formed products, laser-cut components, and complete
      fabrications. Contact us for a quote or to discuss your next steel
      project.
    </p>
  </OneColumn>
  <ContactCTA />
</Layout>

<style lang="scss" is:global>
  @use "@styles" as *;
  #about-hero {
    background: $gradient-bg;
    padding: 0;
    .container {
      gap: 0;
      flex-direction: column-reverse;
      .right-image {
        max-height: 250px;
      }
      .flex-group-col {
        flex: 0 0 50%;
        padding: 2rem $gutter;
        align-items: flex-start;
      }
      @include container-query(small-laptop) {
        flex-direction: row;
        .right-image {
          max-height: 100%;
        }
      }
    }
  }

  #about {
    .flex-group-col {
      align-items: flex-start;
    }
    .certs {
      display: flex;
      flex-direction: row;
      gap: 2rem;
      img {
        width: auto;
        height: 150px;
      }
    }
  }
</style>
